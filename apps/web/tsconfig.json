{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/types": ["../../packages/types/src/index.ts"],
      "@workspace/feedback": ["../../packages/feedback/src/index.ts"],
      "@workspace/feedback/*": ["../../packages/feedback/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "proxy.ts.disabled",
    "../../packages/ui/src/hooks/use-mobile.ts",
  ],
  "exclude": ["node_modules"]
}
